---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('press');
  return posts.map((post) => ({ params: { slug: post.id.replace(/\.(md|mdx)$/, '') }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const image = post.data.image || `${import.meta.env.BASE_URL}images/press/waya-reference.svg`;
---
<BaseLayout title={post.data.seoTitle || `${post.data.title} | Prensa`} description={post.data.description} keywords={post.data.keywords?.join(', ')}>
  <section class="hero">
    <div class="container">
      <div class="eyebrow">{post.data.category}</div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <p class="meta">{post.data.outlet} · {post.data.date.toLocaleDateString('es-AR')} · {post.data.author}</p>
      <div class="tags">{post.data.tags.map((tag) => <span class="pill">{tag}</span>)}</div>
      {post.data.url && <div class="actions"><a class="btn primary" href={post.data.url} target="_blank" rel="noopener">Ver nota original</a></div>}
      <img class="article-cover" src={image.startsWith('/') ? `${import.meta.env.BASE_URL}${image.slice(1)}` : image} alt={post.data.imageAlt || post.data.title} />
    </div>
  </section>
  <section class="section">
    <div class="container card article-body">
      <Content />
    </div>
  </section>
</BaseLayout>
