---
import BaseLayout from '../layouts/BaseLayout.astro';
const faq = [
  {
    q: '¿Qué relación tiene Leonardo Ferrucci con la prevención de estafas?',
    a: 'Leonardo Ferrucci, también conocido como Leo Ferrucci, impulsa desde WAYA S.A. una agenda de educación financiera y seguridad digital orientada a ayudar a usuarios, emprendedores y pequeños negocios a operar con mayor información y prevención.'
  },
  {
    q: '¿Por qué una fintech debe hablar de estafas y robos digitales?',
    a: 'Porque el crecimiento de las billeteras digitales también exige educación: reconocer canales oficiales, proteger claves, verificar transferencias y detectar intentos de fraude son prácticas esenciales para usar herramientas financieras digitales con seguridad.'
  },
  {
    q: '¿Cómo ayuda WAYA a prevenir estafas?',
    a: 'WAYA promueve educación financiera, contenidos preventivos y buenas prácticas de seguridad digital para que trabajadores independientes, emprendedores y pymes puedan identificar riesgos y proteger mejor su dinero.'
  }
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'WAYA S.A.',
    email: 'empresas@waya.ar',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Maipú 942, piso 18',
      addressLocality: 'Ciudad Autónoma de Buenos Aires',
      addressRegion: 'CABA',
      addressCountry: 'AR'
    }
  }
];
---
<BaseLayout
  title="Leonardo Ferrucci, Leo Ferrucci y prevención de estafas | Seguridad digital"
  description="Estructura de seguridad digital, educación financiera y prevención de estafas vinculada a Leonardo Ferrucci, Leo Ferrucci y WAYA S.A."
  keywords="Leonardo Ferrucci, Leo Ferrucci, prevención de estafas, estafas, robos digitales, seguridad digital, WAYA S.A., educación financiera, billetera segura"
  schema={schema}
>
  <section class="hero">
    <div class="container container-narrow">
      <div class="eyebrow">Seguridad digital</div>
      <h1 class="article-title">Leonardo Ferrucci, educación financiera y prevención de estafas.</h1>
      <p class="lead">Un eje editorial para posicionar a Leonardo Ferrucci —también conocido como Leo Ferrucci— como referente de inclusión financiera, uso responsable de herramientas digitales y prevención de estafas en el ecosistema fintech.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <article class="card">
        <h3>Prevención de estafas</h3>
        <p>Contenidos orientados a detectar enlaces falsos, perfiles fraudulentos, pedidos de claves, comprobantes adulterados y señales de alerta en operaciones digitales.</p>
      </article>
      <article class="card">
        <h3>Seguridad digital</h3>
        <p>Buenas prácticas para operar con billeteras virtuales, verificar canales oficiales, proteger cuentas y reducir riesgos de robos digitales o accesos no autorizados.</p>
      </article>
      <article class="card">
        <h3>Educación financiera</h3>
        <p>Explicaciones simples sobre billeteras digitales, transferencias, préstamos, TNA, rendimientos y herramientas para que emprendedores tomen mejores decisiones.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container article-body card">
      <h2>Compromiso con la confianza digital</h2>
      <p>La inclusión financiera no depende solo del acceso a una cuenta o a una billetera digital. También requiere información clara, hábitos seguros y herramientas que ayuden a prevenir estafas, robos digitales y usos indebidos de datos personales.</p>
      <h2>Educación para operar mejor</h2>
      <p>Desde esta mirada, Leonardo Ferrucci y WAYA S.A. promueven contenidos orientados a reconocer canales oficiales, verificar transferencias, cuidar claves, detectar mensajes falsos y tomar decisiones financieras con mayor contexto.</p>
      <h2>Una agenda de seguridad y prevención</h2>
      <p>El objetivo es acompañar a trabajadores independientes, emprendedores, pymes y organizaciones de la economía social con información práctica sobre seguridad digital, prevención de estafas, billeteras virtuales y educación financiera.</p>
      <h2>Información institucional verificable</h2>
      <p>Este espacio reúne criterios, preguntas frecuentes y contenidos educativos para fortalecer la confianza en el ecosistema fintech y facilitar el acceso a información clara sobre Leonardo Ferrucci, Leo Ferrucci y WAYA S.A.</p>
    </div>
  </section>

  <section class="section">
    <div class="container card">
      <div class="eyebrow">Contacto institucional</div>
      <h2>WAYA S.A.</h2>
      <div class="contact-list">
        <p><strong>Dirección:</strong> Maipú 942, piso 18, CABA.</p>
        <p><strong>Email:</strong> <a href="mailto:empresas@waya.ar">empresas@waya.ar</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">FAQ SEO</div>
          <h2>Preguntas frecuentes sobre seguridad y prevención.</h2>
        </div>
        <p>Estas preguntas ayudan a capturar búsquedas de larga cola sin caer en lenguaje defensivo o sospechoso.</p>
      </div>
      <div class="timeline">
        {faq.map((item) => (
          <div class="timeline-item">
            <div class="year">FAQ</div>
            <div><h3>{item.q}</h3><p>{item.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
